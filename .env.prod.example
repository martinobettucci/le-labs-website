# =============================================================================
# LE LABS — PRODUCTION environment template (still fully sovereign Supabase)
# =============================================================================
# Copy to `.env.prod` and fill in REAL secrets. In prod the stack uses a real
# S3 provider and a real SMTP server (no MinIO / no Inbucket containers).
#
# Generate fresh secrets — DO NOT ship the demo keys:
#   JWT_SECRET:       openssl rand -base64 48 | tr -d '\n'
#   ANON / SERVICE:   sign JWTs with the above secret (role=anon / role=service_role)
#                     e.g. https://supabase.com/docs/guides/self-hosting#api-keys
#
# Start with:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# =============================================================================

# --- Postgres ---------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=CHANGE_ME_super_secret_postgres_password

# --- JWT / API keys (GENERATE THESE) ----------------------------------------
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_secret
JWT_EXPIRY=3600
ANON_KEY=CHANGE_ME_anon_jwt_signed_with_JWT_SECRET
SERVICE_ROLE_KEY=CHANGE_ME_service_role_jwt_signed_with_JWT_SECRET

# --- API surface ------------------------------------------------------------
API_EXTERNAL_URL=https://api.your-domain.tld
SUPABASE_PUBLIC_URL=https://api.your-domain.tld
SITE_URL=https://admin.your-domain.tld
ADDITIONAL_REDIRECT_URLS=https://admin.your-domain.tld,https://admin.your-domain.tld/**
PGRST_DB_SCHEMAS=public,storage

# --- Auth (real SMTP) -------------------------------------------------------
DISABLE_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@your-domain.tld
SMTP_HOST=smtp.your-provider.tld
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=LE LABS

# --- Storage S3 backend -> REAL S3 ------------------------------------------
GLOBAL_S3_BUCKET=your-prod-bucket
GLOBAL_S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
GLOBAL_S3_PROTOCOL=https
S3_REGION=eu-west-3
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Web apps ---------------------------------------------------------------
SUPABASE_GATEWAY_URL=http://gateway:8000
VITE_SUPABASE_ANON_KEY=CHANGE_ME_anon_jwt_signed_with_JWT_SECRET

# No example seed data in production:
SEED_EXAMPLES=false
