# =============================================================================
# LE LABS — DEV / DEMO environment (fully sovereign, self-contained)
# =============================================================================
# Everything here is self-hosted: Postgres, Auth, REST, Storage, MinIO (S3) and
# Inbucket (SMTP catch-all). The keys below are the well-known Supabase *demo*
# keys — fine for local development, NEVER use them in production.
#
# Start the stack with:
#   docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up -d --build
# =============================================================================

# --- Postgres ---------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# --- JWT / API keys (DEMO keys, signed with JWT_SECRET below) ----------------
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# --- API surface ------------------------------------------------------------
# Single Supabase origin (exposed by the nginx gateway). For host browsing.
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:5174
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:5173/**,http://localhost:5174,http://localhost:5174/**,http://backoffice:5173,http://backoffice:5173/**,http://website:5173,http://website:5173/**
PGRST_DB_SCHEMAS=public,storage

# --- Auth (magic-link / OTP via email) --------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
# SMTP -> Inbucket catch-all (dev). Inbucket has no TLS, so SMTP_USER/PASS are
# left EMPTY on purpose: GoTrue then sends unauthenticated over plaintext
# (otherwise it errors with "unencrypted connection" when given credentials).
SMTP_ADMIN_EMAIL=admin@lelabs.local
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=LE LABS (dev)

# --- Storage S3 backend -> MinIO (dev) --------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
GLOBAL_S3_BUCKET=supabase-storage
GLOBAL_S3_ENDPOINT=http://minio:9000
GLOBAL_S3_PROTOCOL=http
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# --- Web apps ---------------------------------------------------------------
# Apps talk to Supabase same-origin via their own /supabase reverse-proxy, which
# (server-side) points at this gateway URL:
SUPABASE_GATEWAY_URL=http://gateway:8000
# Public (browser-exposed) anon key used by the apps:
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Seed the 4 hard-coded example projects (dev only):
SEED_EXAMPLES=true
